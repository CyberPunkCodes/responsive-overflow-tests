{
  "name": "responsive-overflow-tests",
  "version": "0.3.0",
  "type": "module",
  "description": "Framework-agnostic Playwright tests that catch horizontal-overflow layout breaks across Tailwind breakpoints and real-device viewports \u2014 no screenshots, no AI.",
  "license": "MIT",
  "author": "CyberPunk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberPunkCodes/responsive-overflow-tests.git"
  },
  "bugs": {
    "url": "https://github.com/CyberPunkCodes/responsive-overflow-tests/issues"
  },
  "homepage": "https://github.com/CyberPunkCodes/responsive-overflow-tests#readme",
  "keywords": [
    "playwright",
    "responsive",
    "overflow",
    "tailwind",
    "viewport",
    "layout",
    "testing",
    "ci"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "responsive-overflow-tests": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "ADVANCED.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
